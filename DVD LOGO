import pygame

# pygame setup
pygame.init()
screen = pygame.display.set_mode((1200,800), flags=pygame.SCALED, vsync=1)
clock = pygame.time.Clock()
running = True

color = 'black'

img = pygame.image.load("/Users/hugohammarstedt/code/oraklet/dvd.png")
imgX = 9
imgY = 9
imgXV = 9
imgYV = 9


while running:
    # poll for events
    # pygame.QUIT event means the user clicked X to close your window
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        if event.type == pygame.KEYDOWN and event.key == 32:
            color = 'black'


    # fill the screen with a color to wipe away anything from last frame
    screen.fill(color)

    if imgX+img.width > screen.width or imgX < 0:
        imgXV *= -1
    if imgY+img.height > screen.height or imgY < 0:
        imgYV *= -1

    imgX += imgXV
    imgY += imgYV

    screen.blit(img,(imgX,imgY))

    # RENDER YOUR GAME HERE

    # flip() the display to put your work on screen
    pygame.display.flip()

    clock.tick(60)  # limits FPS to 60

pygame.quit()